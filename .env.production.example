DEBUG=False
PRODUCTION_ENV_FILE=.env.production.example
SECRET_KEY=replace-with-a-random-secret-without-dollar-signs
ALLOWED_HOSTS=lms.example.com
CSRF_TRUSTED_ORIGINS=https://lms.example.com
DB_NAME=atom_lms_db
DB_USER=lms_user
DB_PASSWORD=replace-with-a-strong-password
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Compose overrides service hostnames to postgres and redis.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

LOGIN_IP_RATE=100/10m
LOGIN_EMAIL_RATE=10/10m
PASSWORD_RESET_IP_RATE=10/h
PASSWORD_RESET_EMAIL_RATE=10/h
COMPILER_RATE=10/m
COMPILER_MAX_CONCURRENT=8
COMPILER_RETRY_AFTER=5
COMPILER_DOCKER_BINARY=docker
COMPILER_SANDBOX_IMAGE=atomm-lms-compiler-sandbox:latest
COMPILER_SANDBOX_MEMORY=256m
COMPILER_SANDBOX_CPUS=0.5
COMPILER_SANDBOX_PIDS=64
COMPILER_SANDBOX_WALL_TIMEOUT=25
COMPILER_OUTPUT_LIMIT=262144

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
