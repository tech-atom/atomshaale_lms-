# Production values must come from the deployer's secret manager.
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=lms.example.com
CSRF_TRUSTED_ORIGINS=https://lms.example.com

DB_NAME=atom_lms_db
DB_USER=lms_user
DB_PASSWORD=replace-with-database-secret
DB_HOST=postgres
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Redis is required for multiple web processes, sessions, and shared rate limits.
REDIS_URL=redis://redis:6379/0

# Authentication limits are per IP and per submitted email.
LOGIN_IP_RATE=100/10m
LOGIN_EMAIL_RATE=10/10m
PASSWORD_RESET_IP_RATE=10/h
PASSWORD_RESET_EMAIL_RATE=10/h

# This is an admission ceiling per web process, not total cluster capacity.
COMPILER_RATE=10/m
COMPILER_MAX_CONCURRENT=8
COMPILER_RETRY_AFTER=5
COMPILER_DOCKER_BINARY=docker
COMPILER_SANDBOX_IMAGE=atomm-lms-compiler-sandbox:latest
COMPILER_SANDBOX_MEMORY=256m
COMPILER_SANDBOX_CPUS=0.5
COMPILER_SANDBOX_PIDS=64
COMPILER_SANDBOX_WALL_TIMEOUT=25
COMPILER_OUTPUT_LIMIT=262144

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-secret
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Set these true only when TLS is terminated by the deployer.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
