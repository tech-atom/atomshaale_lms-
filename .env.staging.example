DEBUG=False
SECRET_KEY=generate-with-python-secrets-token-urlsafe-64
ALLOWED_HOSTS=staging.example.com
CSRF_TRUSTED_ORIGINS=https://staging.example.com

DB_NAME=atom_lms_staging
DB_USER=atom_lms_staging
DB_PASSWORD=load-from-secret-manager
DB_HOST=postgres
DB_PORT=5432
DB_CONN_MAX_AGE=60

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

COMPILER_RATE=10/m
COMPILER_MAX_CONCURRENT=8
COMPILER_DOCKER_BINARY=docker
COMPILER_SANDBOX_IMAGE=atomm-lms-compiler-sandbox:latest
COMPILER_SANDBOX_MEMORY=256m
COMPILER_SANDBOX_CPUS=0.5
COMPILER_SANDBOX_PIDS=64
COMPILER_SANDBOX_WALL_TIMEOUT=25
COMPILER_OUTPUT_LIMIT=262144

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.staging.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=load-from-secret-manager
EMAIL_HOST_PASSWORD=load-from-secret-manager
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=staging@example.com

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
STAGING_WEB_PORT=8001